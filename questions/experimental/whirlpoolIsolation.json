{
  "class": "org.batfish.minesweeper.question.isolation.IsolationQuestion",
  "differential": false,
  "target": "${target}",
  "location": "${location}",
  "assumption_locations": "${assumption_locations}",
  "assumptions": "${assumptions}",
  "default_assumption": "${default_assumption}",
  "exact_communities": "${exact_communities}",
  "isolate_violations": "${isolate_violations}",
  "compute_data_plane": "${compute_data_plane}",
  "instance": {
    "description": "...",
    "instanceName": "whirlpoolIsolation",
    "longDescription": "This question...",
    "orderedVariableNames": [
      "target",
      "location",
      "assumption_locations",
      "assumptions",
      "default_assumption",
      "exact_communities",
      "isolate_violations",
      "compute_data_plane"
    ],
    "tags": [
      "routing"
    ],
    "variables": {
      "target": {
        "description": "Safety property to verify",
        "type": "string",
        "optional": true,
        "displayName": "Target Property"
      },
      "location": {
        "description": "Location to verify property at within network",
        "type": "string",
        "optional": true,
        "displayName": "Location"
      },
      "assumption_locations": {
        "description": "Locations where you make assumption about traffic",
        "type": "string",
        "optional": true,
        "displayName": "Locations for Assumptions"
      },
      "assumptions": {
        "description": "Assumptions made about traffic, should be one-to-one with assumption_locations",
        "type": "string",
        "optional": true,
        "displayName": "Assumptions"
      },
      "default_assumption": {
        "description": "Default assumption on incoming edges, if not specified",
        "type": "string",
        "optional": true,
        "displayName": "Default Incoming Assumptions"
      },
      "exact_communities": {
        "description": "Flag indicating if communities provided should be treated as exact",
        "type": "boolean",
        "optional": true,
        "displayName": "Implicitly negate communities not mentioned"
      },
      "isolate_violations": {
        "description": "Flag indicating if in case of failure, the failures should be isolated",
        "type": "boolean",
        "optional": true,
        "displayName": "Isolate the violations, if applicable"
      },
      "compute_data_plane": {
        "description": "Flag indicating if data plane should be computed (more robust, but expensive)",
        "type": "boolean",
        "optional": true,
        "displayName": "Computes the data plane"
      }
    }
  }
}
